# Glukoz Panel — example configuration. Copy to `.env` and fill in the blanks.
# Full reference: docs/configuration.md

NODE_ENV=production
APP_URL=https://glucose.example.com
PORT=3000
DATABASE_URL=postgresql://glukoz:CHANGE_ME@db:5432/glukoz

# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts stored LibreLinkUp credentials. Keep it safe; if it changes, stored accounts must be re-added.
ENCRYPTION_KEY=
# At least 32 characters:  openssl rand -base64 48
SESSION_SECRET=

# LibreLinkUp (unofficial API — see docs/librelinkup.md)
LLU_PRODUCT=llu.android
LLU_VERSION=4.16.0
LLU_POLL_SECONDS=60            # hard lower bound in code: 60
LLU_GRAPH_MINUTES=15
LLU_LOGBOOK_HOURS=6
LLU_MOCK=false                 # true: synthetic data, no calls to LibreLinkUp
LLU_MOCK_FAIL=none             # none|401|429|920|network (mock mode only)

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

DEFAULT_TIMEZONE=Europe/Istanbul
DATA_RETENTION_DAYS=730
REPORT_PDF_SERVER=false
ALERT_NOTIFY_RESOLVED=true
LOG_LEVEL=info

# "Source code" link shown in the web UI footer (AGPL-3.0 section 13).
# If you run a modified version, point this to YOUR repository. Read at build time;
# with Docker pass it as: --build-arg VITE_SOURCE_URL=https://github.com/you/your-fork
VITE_SOURCE_URL=https://github.com/mbahadirs/glukoz

# One-off maintenance (leave empty/false normally — see docs/deployment.md)
# RESTORE_SNAPSHOT_B64=
# MERGE_DUPLICATE_PATIENTS=false

# Docker Compose (docker/docker-compose.yml)
POSTGRES_PASSWORD=CHANGE_ME
BACKUP_PASSPHRASE=
DOMAIN=glucose.example.com
